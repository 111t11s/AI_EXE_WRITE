# Server-only configuration; never put this file into the Android app.
HOST=127.0.0.1
PORT=8000
AITXT_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=https://localhost,capacitor://localhost
ENABLE_API_DOCS=false
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_HOURS=720
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aitxt
DB_PASSWORD=
DB_NAME=aitxt
DB_TLS_REQUIRED=false
DB_TLS_CA=
# 模型名称和服务地址在 core/model_config.py 配置；环境变量只存密钥。
GPT_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GPT_BASE_URL=https://api.meai.cloud/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 热点选题（可选）：抓取热搜的缓存分钟数、超时秒数，以及额外的 JSON 数据源（逗号分隔）。
# TREND_CACHE_MINUTES=30
# TREND_TIMEOUT=8
# TREND_SOURCE_URLS=
REQUEST_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FILE=/var/log/aitxt/ai_write.log
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
