# Server-only configuration; never put this file into the Android app.
HOST=127.0.0.1
PORT=8000
AITXT_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=https://localhost,capacitor://localhost
ENABLE_API_DOCS=false
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_HOURS=720
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aitxt
DB_PASSWORD=
DB_NAME=aitxt
DB_TLS_REQUIRED=false
DB_TLS_CA=
API_KEY=
PROXY_URL=https://your-model-provider.example/v1
# Gemini is the default model when these values are configured; Flash and Pro share the same key and URL.
GEMINI_API_KEY=
GEMINI_PROXY_URL=https://qunaapi.com/v1
GEMINI_3_8_FLASH=gemini-3.8-flash
GEMINI_3_1_PRO=gemini-3.1-pro-preview
# Fallback model used only when Gemini is not configured.
MODEL_NAME=your-model-name
# 可选的 DeepSeek 配置；三项齐全后，页面生成时可选择该模型。
DEEPSEEK_API_KEY=
DEEPSEEK_PROXY_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat
# 热点选题（可选）：抓取热搜的缓存分钟数、超时秒数，以及额外的 JSON 数据源（逗号分隔）。
# TREND_CACHE_MINUTES=30
# TREND_TIMEOUT=8
# TREND_SOURCE_URLS=
REQUEST_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FILE=/var/log/aitxt/ai_write.log
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
