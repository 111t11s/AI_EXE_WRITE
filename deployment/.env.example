# Server-only configuration; never put this file into the Android app.
HOST=127.0.0.1
PORT=8000
AITXT_API_BASE_URL=http://127.0.0.1:8000/api/v1
CORS_ORIGINS=https://localhost,capacitor://localhost
ENABLE_API_DOCS=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aitxt
DB_PASSWORD=
DB_NAME=aitxt
DB_TLS_REQUIRED=false
DB_TLS_CA=
API_KEY=
PROXY_URL=https://your-model-provider.example/v1
MODEL_NAME=your-model-name
REQUEST_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FILE=/var/log/aitxt/ai_write.log
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
