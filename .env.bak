# 环境变量模板：在新环境中复制为 .env，并替换所有占位值后再启动。
# 密钥、密码等真实配置只写入本地 .env。

# 应用与服务
APP_NAME="<填写应用名称>"
APP_VERSION="<填写应用版本，例如 0.1.0>"
DEBUG="<填写 true 或 false>"
HOST="<填写监听地址，例如 127.0.0.1>"
PORT="<填写监听端口，例如 8000>"
API_PREFIX="<填写 API 路径前缀，例如 /v1>"

# 模型服务
API_KEY="<填写模型服务的 API 密钥>"
PROXY_URL="<填写模型服务的基础 URL，例如 https://provider.example/v1>"
MODEL_NAME="<填写模型服务提供的模型名称>"

# MySQL
DB_HOST="<填写 MySQL 主机地址>"
DB_PORT="<填写 MySQL 端口，例如 3306>"
DB_USER="<填写 MySQL 用户名>"
DB_PASSWORD="<填写 MySQL 密码>"
DB_NAME="<填写 MySQL 数据库名>"
